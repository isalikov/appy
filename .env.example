# Copy to .env for local development (`mise run setup` does it for you).
# mise loads this file into every task; Vite and Playwright read it from the
# repo root; docker compose reads it for the infrastructure. `${VAR}`
# references are expanded. In deployed environments the platform injects the
# same variables.

APP_ENV=local

# ======================================================================= apps
# Every app runs on http://localhost:<APP>_PORT locally. No local domains:
# browsers treat localhost as a secure context, cookies are shared across
# ports, and nothing needs /etc/hosts.
LANDING_PORT=5174
WEB_PORT=5173
API_PORT=8000

# Public URL of each app, as a browser reaches it. Used for every cross-app
# link and redirect (landing "Log in" -> web, OAuth callback -> web), for CORS
# and for cookies. PUBLIC_* values are exposed to frontend bundles (build time
# locally, runtime /env.js in containers): never put secrets here.
PUBLIC_LANDING_URL=http://localhost:${LANDING_PORT}
PUBLIC_WEB_URL=http://localhost:${WEB_PORT}
PUBLIC_API_URL=http://localhost:${API_PORT}

# ============================================================= infrastructure
# Host ports and credentials of the services started by `mise run infra:up`.
POSTGRES_USER=appy
POSTGRES_PASSWORD=appy
POSTGRES_DB=appy
POSTGRES_PORT=5432

MONGO_USER=appy
MONGO_PASSWORD=appy
MONGO_PORT=27017

REDIS_PORT=6379

# ======================================================================== api
API_LOG_LEVEL=INFO
API_LOG_JSON=false
# Comma-separated browser origins allowed to call the API.
API_CORS_ORIGINS=${PUBLIC_LANDING_URL},${PUBLIC_WEB_URL}
API_POSTGRES_DSN=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
API_MONGO_DSN=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:${MONGO_PORT}/?authSource=admin
API_MONGO_DB=appy
API_REDIS_DSN=redis://localhost:${REDIS_PORT}/0
API_TASKS_REDIS_DSN=redis://localhost:${REDIS_PORT}/1

# Used by `pytest -m integration`; databases are created by infra/postgres/init.
API_TEST_POSTGRES_DSN=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}_test
API_TEST_MONGO_DB=appy_test
API_TEST_REDIS_DSN=redis://localhost:${REDIS_PORT}/15
