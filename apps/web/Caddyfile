{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Runtime config: /env.js (and pre-rendered HTML) are rendered from the
	# container environment, so one image works with any PUBLIC_*_URL values.
	@runtime_env path /env.js
	templates @runtime_env {
		mime text/javascript application/javascript
	}
	templates {
		mime text/html
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /env.js Cache-Control "no-store"
	header *.html Cache-Control "no-cache"

	handle /healthz {
		respond "ok" 200
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
