{
  "name": "appy",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "[ -n \"${CI:-}\" ] || lefthook install",
    "build": "pnpm -r --filter './apps/*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/lucide": "^1.2.147",
    "@unocss/eslint-plugin": "^66.11.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0"
  }
}
